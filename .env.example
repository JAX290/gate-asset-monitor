# ============================================================================
# Gate Asset Monitor - configuration template
# Copy to `.env` and fill in. NEVER commit `.env` or share it. It contains secrets.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# 1) Data source mode
#    mock = deterministic DEMO data, no keys needed (for wiring things up)
#    live = real Gate.io API v4. Switch to this only after the read-only key is ready.
# ---------------------------------------------------------------------------
DATA_MODE=mock

# ---------------------------------------------------------------------------
# 2) Gate.io API v4 credentials  (READ-ONLY permission only!)
#    Create at: Gate.io -> Account -> API Management -> APIv4 Keys
#      - Permissions: tick ONLY "Read" (读取). DO NOT enable trade / withdraw.
#      - Bind IP allowlist to THIS server's public IP (strongly recommended).
#    Leave empty in mock mode. These are read ONLY by the server process.
#    They are NEVER sent to the browser, written to disk, logged, or exported.
# ---------------------------------------------------------------------------
GATE_API_KEY=
GATE_API_SECRET=

# Optional overrides
# GATE_BASE_URL=https://api.gateio.ws/api/v4
# GATE_SETTLES=usdt              # 只填【实际已开通】的合约账户结算币。
#                                 # 填了未开通的(如 btc)会每轮 400 USER_NOT_FOUND,
#                                 # 且该 note 会被前端渲染成「数据源提示」红条。
#                                 # 生产推荐 usdt（未开 BTC 本位合约时）。
# GATE_TIMEOUT_MS=12000
# GATE_TRADE_PAIRS=BTC_USDT,ETH_USDT
#      # In live mode, also pull /spot/my_trades for these pairs (cost/behaviour
#      # analysis). Leave empty to skip. Gate requires currency_pair per request.

# ---------------------------------------------------------------------------
# 3) Server / network binding
#    Tailscale-only deployments: deploy/start-tailscale.sh resolves this node's
#    100.x address at boot and exports HOST automatically, so the public
#    interface has nothing listening on PORT at all.
# ---------------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0            # overridden by start-tailscale.sh on the VPS

# ---------------------------------------------------------------------------
# 3b) Access control  *** TAILSCALE-ONLY DEPLOYMENT ***
#    When true, requests from outside the Tailscale ranges get 403 BEFORE any
#    routing. Defence-in-depth on top of HOST binding.
#    Defaults (verified via `tailscale ip`): CGNAT 100.64.0.0/10,
#    ULA fd7a:115c:a1e0::/48, plus loopback for local health checks.
#    TRUST_PROXY stays OFF: X-Forwarded-For is client-forgeable, never trusted.
# ---------------------------------------------------------------------------
TAILSCALE_ONLY=false     # the VPS launcher forces this to true
# ALLOW_CIDRS=100.64.0.0/10,127.0.0.0/8,::1,fd7a:115c:a1e0::/48
# TRUST_PROXY=false
# PROXY_IP_HEADER=x-forwarded-for

# ---------------------------------------------------------------------------
# 4) Collector
# ---------------------------------------------------------------------------
SNAPSHOT_INTERVAL_SEC=300       # 5 minutes. Min 30, max 86400.
RETENTION_DAYS=365              # snapshots older than this are pruned
# PRICE_SAMPLE_EVERY=12         # 每 N 个采集周期才写一次全市场价格(1..100)。
#                                 # /spot/tickers 每次约 2160 个币种;5min 周期下
#                                 # =1 约 162MB/天,=12 约 13.5MB/天。快照/归因
#                                 # 不依赖 prices 链密度,生产强烈建议 12。
#                                 # 注意:prices.jsonl 是哈希链事实层,历史不可删;
#                                 # 该配置只控制【未来】写入频率。
#                                 # 改完必须 systemctl restart gate-asset-monitor。
#
# Disk watermark guard (v5.1): fact files are append-only and are NEVER
# truncated. Below the soft watermark the sampling interval is doubled
# automatically (512MB -> x2, 256MB -> x4, 128MB -> x8); below the hard
# watermark, prices + enrichment writes stop entirely while snapshots continue.
# Status: /api/summary -> status.diskGuard. Logged only when the level changes.
# DISK_GUARD_ENABLED=true        # false = disable the guard
# DISK_GUARD_MIN_FREE_MB=512     # soft watermark (32..100000)
# DISK_GUARD_HARD_FREE_MB=128    # hard watermark (16..100000)
# DISK_GUARD_MAX_SAMPLE_EVERY=100 # cap for the automatic multiplier
# EVENT_LOOKBACK_DAYS=90        # first live backfill window for the ledger (1..730)
# COLLECT_EVENTS=true           # in live mode pull events+tickers each cycle

# ---------------------------------------------------------------------------
# 4b) Analytics (Attribution / Risk / Cost)
#    Formulas are documented in docs/METRICS.md. All are server-side only.
# ---------------------------------------------------------------------------
# BENCHMARK_CURRENCY=BTC        # benchmark for beta / excess return (needs prices)
# RISK_FREE_RATE=0              # annual risk-free rate for Sharpe/Sortino, e.g. 0.02
# ANALYTICS_LIMIT=0             # snapshots fed to the analytics window (0 = all)


# ---------------------------------------------------------------------------
# 4c) Market context — 主流币基准行情 + 大环境事件
#    K 线来自 Gate 公开端点 /spot/candlesticks，【不需要 API 密钥/签名】。
#    事件台账来源：manual(人工标注) / auto(行情异动自动检测) / mock(DEMO)。
#    系统不内置实时新闻源；source=auto 是预留的外部新闻适配器接点。
# ---------------------------------------------------------------------------
# MARKET_SYMBOLS=BTC,ETH          # 对比的主流币（可加 SOL,BNB... 需交易对存在）
# MARKET_QUOTE=USDT              # 计价币，组成 {SYMBOL}_{QUOTE} 交易对
# MARKET_CANDLE_INTERVAL=1h      # K 线周期：1m/5m/15m/30m/1h/4h/8h/1d
# MARKET_LOOKBACK_DAYS=30        # 回溯天数（Gate 上限 10000 根，1h 下勿超过 330 天）
# MARKET_COLLECT=true            # live 模式每轮采集时拉取公开 K 线
# MARKET_AUTO_EVENTS=true        # 从 K 线大幅波动自动生成「行情异动」事件
# MARKET_EVENT_THRESHOLD_PCT=3   # 单根 K 线涨跌幅绝对值超过该值(%)即记为事件
# MARKET_EVENT_WINDOW_BARS=8     # 事件窗口前后各 N 个快照
# MARKET_INDEX_WEIGHTS=BTC:0.6,ETH:0.4   # 合成「市场指数」权重（对有数据的币种重归一化）

# ---------------------------------------------------------------------------
# 5) Dashboard access protection  *** SET THIS BEFORE EXPOSING A PUBLIC DOMAIN ***
#    If ACCESS_TOKEN is empty, the dashboard is open to anyone who knows the URL.
#    Use a long random string, e.g.: openssl rand -hex 24
# ---------------------------------------------------------------------------
ACCESS_TOKEN=
# AUTH_ENABLED=true              # auto-enabled when ACCESS_TOKEN is set
# SESSION_TTL_SEC=604800         # login session lifetime (default 7 days)
# COOKIE_SECURE=false            # set true ONLY behind HTTPS; HTTP + Secure = no login
# LOGIN_MAX_ATTEMPTS=5           # failures per socket peer before a temporary lock
# LOGIN_WINDOW_SEC=300           # sliding window for those failures
# LOGIN_LOCK_SEC=300             # lock duration after the threshold
#   Note: X-Forwarded-For is NEVER trusted for the limiter. /api/health is
#   unauthenticated (liveness only, no account data) but still Tailscale-gated.

# ---------------------------------------------------------------------------
# 6) Misc
# ---------------------------------------------------------------------------
QUOTE_LABEL=USD                 # cosmetic label shown in the dashboard
# DATA_DIR=/var/lib/gate-monitor # override where the 9 append-only .jsonl files live
# ENV_FILE=/path/to/.env        # override which .env file is loaded

# Offline full export (deploy/export-all.js) — no HTTP, no token, cron-friendly:
#   DATA_DIR=/opt/gate-asset-monitor/data \
#   OUT_DIR=/backup/gate \
#   NO_ZIP=1 \
#     /opt/gate-asset-monitor/.runtime/node/bin/node deploy/export-all.js
# OUT_DIR   default = <DATA_DIR>/exports     NO_ZIP=1 = skip the ZIP, keep loose files
# Produces 34 tidy tables (csv+jsonl) + analytics.json + manifest.json + 9 raw/*.jsonl

# ---------------------------------------------------------------------------
# 6.5) Extended read-only enrichment   *** v5 ***
#    Uses Gate endpoints that v4 discarded, written to a LOW-frequency
#    enrichment.jsonl chain (one record per N collector cycles):
#      GET /spot/tickers            full market breadth + 11 fields per holding
#      GET /wallet/fee              nominal fee schedule
#      GET /futures/{settle}/tickers funding / mark / index / open interest / basis
#      GET /spot/order_book         top-5 depth for holdings + benchmarks
#      GET /spot/open_orders        working orders
#      GET /futures/{settle}/positions  leverage / liq price / unrealised pnl
#      GET /margin/accounts         risk / borrowed
#    Design: "use as much API data as possible, but keep rarely-used numbers
#    out of the way" — the dashboard shows ONE thin headline strip and tucks
#    the 9 export tables into a collapsed "更多数据" panel.
#    Every optional sub-request is ISOLATED: a failure only lands in
#    lastEnrichNotes, never in the top red error bar, and never aborts a snapshot.
# ---------------------------------------------------------------------------
# ENRICH_COLLECT=true          # false = disable extended collection entirely
# ENRICH_SAMPLE_EVERY=0        # 0 = follow PRICE_SAMPLE_EVERY; else own cadence
# ENRICH_FUTURES_CONTRACTS=BTC_USDT,ETH_USDT   # contracts to snapshot funding/basis
# ENRICH_MAX_DETAIL=40         # max holdings to keep full 11-field ticker detail
# ENRICH_MAX_BOOK_PAIRS=6      # max order-book pairs (disk guard)
# ENRICH_PROBE_ACCOUNTS=true   # probe open_orders / positions / margin (signed)
#                              # accounts without futures return USER_NOT_FOUND,
#                              # which is isolated and silent by design.

# ---------------------------------------------------------------------------
# 7) Daily report + WeCom (企业微信) group robot   *** v4 ***
#    The webhook URL contains the robot `key` = a SECRET. Like the Gate keys it
#    is read ONLY by the server process: never sent to the browser, never
#    logged, never written into any fact/export file. The dashboard and all
#    exports only ever show a MASKED form (?key=***abcd).
#    Set EITHER WECOM_WEBHOOK_URL (full URL) OR WECOM_WEBHOOK_KEY (just the key).
#    Official endpoint/limits (developer.work.weixin.qq.com/document/path/91770):
#      POST https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
#      markdown.content <= 4096 bytes UTF-8; text.content <= 2048 bytes;
#      <= 20 messages / minute per robot. Only qyapi.weixin.qq.com is allowed.
# ---------------------------------------------------------------------------
REPORT_ENABLED=false        # true = 每天定时生成并推送；改完必须 systemctl restart
# REPORT_HOUR=9             # 本地时间小时 0..23
# REPORT_MINUTE=0           # 本地时间分钟 0..59
# REPORT_TZ_OFFSET_HOURS=8  # 本地时区偏移(UTC+8)，范围 -12..14
# REPORT_PRESET=24H         # 日报统计区间：8H / 24H / 7D / 30D / ALL
# REPORT_SEND_ON_START=false # 服务启动 8 秒后补发一次(调试用)
# REPORT_KEEP_HISTORY=true  # 把每篇日报写入 append-only reports.jsonl(可导出)
#
# WECOM_WEBHOOK_URL=        # 完整 webhook 地址(含 key)；推荐只用这一项
# WECOM_WEBHOOK_KEY=        # 或只填 key，服务端自动拼官方地址
# WECOM_MENTION_MOBILES=13800000000,13900000000   # 可选，最后一条 text 消息 @人
# WECOM_MENTION_ALL=false   # 或 @all
# WECOM_TIMEOUT_MS=10000    # 单条 POST 超时(2000..60000)

# 未配置 webhook 时：日报仍可预览、生成、存档，只是不推送（优雅失败）。
# 也可完全绕开内置调度，用 cron + 离线 CLI：
#   CRON_TZ=Asia/Shanghai
#   0 9 * * * cd /opt/gate-asset-monitor && \
#     ./.runtime/node/bin/node deploy/daily-report.js --send >> /var/log/gate-report.log 2>&1
#   deploy/daily-report.js --preview   # 只打印不发送、不写历史
#   deploy/daily-report.js --test      # 测试机器人连通性（只发一条短消息）
